<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>
<?import javafx.scene.text.*?>

<BorderPane prefHeight="650" prefWidth="1000" stylesheets="@../css/style.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.hit.client.controller.MainController">

    <!-- ===== LEFT: Sidebar ===== -->
    <left>
        <VBox styleClass="sidebar" spacing="0">
            <VBox styleClass="sidebar-header" spacing="5">
                <Text styleClass="sidebar-title" text="Flight Booking" />
                <Text styleClass="sidebar-subtitle" text="System Client" />
            </VBox>

            <Button fx:id="navDashboard" styleClass="nav-button" text="   Dashboard" onAction="#onDashboard" />
            <Button fx:id="navFlights" styleClass="nav-button" text="   Flight Search" onAction="#onFlightSearch" />
            <Button fx:id="navRoute" styleClass="nav-button" text="   Route Planner" onAction="#onRoutePlanner" />
            <Button fx:id="navBooking" styleClass="nav-button" text="   My Bookings" onAction="#onBookings" />
            <Button fx:id="navUser" styleClass="nav-button" text="   User Account" onAction="#onUserAccount" />
        </VBox>
    </left>

    <!-- ===== RIGHT: Main Content ===== -->
    <center>
        <VBox spacing="0">
            <!-- Header Bar -->
            <HBox styleClass="header-bar" alignment="CENTER_LEFT" spacing="10">
                <Circle fx:id="statusDot" radius="5" styleClass="status-dot" />
                <Label fx:id="statusLabel" styleClass="header-status" text="Servers Online" />
                <Region HBox.hgrow="ALWAYS" />
                <Label styleClass="header-subtitle" text="RouteFinder Algorithm" />
            </HBox>

            <!-- Content Stack -->
            <StackPane VBox.vgrow="ALWAYS" styleClass="content-area">

                <!-- ===== 1. DASHBOARD ===== -->
                <VBox fx:id="dashboardView" spacing="20">
                    <VBox spacing="5">
                        <Text styleClass="welcome-title" text="Welcome to Flight Booking System" />
                        <Text styleClass="welcome-text" text="Manage flights, find optimal routes, and book tickets — all from one dashboard." />
                    </VBox>

                    <HBox spacing="20">
                        <VBox styleClass="stat-card" alignment="CENTER" spacing="8" HBox.hgrow="ALWAYS">
                            <Label styleClass="stat-icon" text="&#9992;" />
                            <Label fx:id="statFlights" styleClass="stat-value" text="0" />
                            <Label styleClass="stat-label" text="Flights Booked" />
                        </VBox>
                        <VBox styleClass="stat-card" alignment="CENTER" spacing="8" HBox.hgrow="ALWAYS">
                            <Label styleClass="stat-icon" text="&#128279;" />
                            <Label styleClass="stat-value" text="3" />
                            <Label styleClass="stat-label" text="Active Servers" />
                        </VBox>
                        <VBox styleClass="stat-card" alignment="CENTER" spacing="8" HBox.hgrow="ALWAYS">
                            <Label styleClass="stat-icon" text="&#9881;" />
                            <Label styleClass="stat-value" text="Dijkstra" />
                            <Label styleClass="stat-label" text="Active Algorithm" />
                        </VBox>
                    </HBox>

                    <HBox spacing="15">
                        <Button text="Search Flights" styleClass="btn-primary" onAction="#onFlightSearch" />
                        <Button text="Plan a Route" styleClass="btn-outline" onAction="#onRoutePlanner" />
                    </HBox>
                </VBox>

                <!-- ===== 2. FLIGHT SEARCH ===== -->
                <VBox fx:id="flightView" managed="false" visible="false" spacing="15">
                    <Text styleClass="section-title" text="Flight Search" />
                    <Text styleClass="section-subtitle" text="Search and view booked flights." />

                    <HBox spacing="15" alignment="CENTER_LEFT">
                        <Label styleClass="form-label" text="Ticket ID:" />
                        <TextField fx:id="searchIdField" promptText="e.g. FT001" prefWidth="200" />
                        <Button text="Search" styleClass="btn-primary" onAction="#onSearchFlight" />
                        <Button text="Refresh All" styleClass="btn-outline" onAction="#onRefreshFlights" />
                    </HBox>

                    <TableView fx:id="flightsTable" prefHeight="280" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="colId" prefWidth="100" text="Ticket ID" />
                            <TableColumn fx:id="colCustomer" prefWidth="150" text="Customer" />
                            <TableColumn fx:id="colSource" prefWidth="120" text="Source" />
                            <TableColumn fx:id="colDest" prefWidth="120" text="Destination" />
                            <TableColumn fx:id="colPrice" prefWidth="100" text="Price" />
                        </columns>
                    </TableView>

                    <TextArea fx:id="flightResultArea" styleClass="result-area" prefHeight="80" editable="false" promptText="Results will appear here..." />
                </VBox>

                <!-- ===== 3. ROUTE PLANNER ===== -->
                <VBox fx:id="routeView" managed="false" visible="false" spacing="15">
                    <Text styleClass="section-title" text="Route Planner" />
                    <Text styleClass="section-subtitle" text="Find the shortest or cheapest flight route using graph algorithms." />

                    <VBox styleClass="graph-input-area" spacing="10">
                        <Label styleClass="card-title" text="Flight Route Graph" />
                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <Label styleClass="form-label" text="From:" />
                            <TextField fx:id="routeFrom" promptText="e.g. Paris" prefWidth="150" />
                            <Label styleClass="form-label" text="To:" />
                            <TextField fx:id="routeTo" promptText="e.g. Milan" prefWidth="150" />
                        </HBox>
                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <Label styleClass="form-label" text="Add edge (city1,city2,weight):" />
                            <TextField fx:id="edgeInput" promptText="e.g. Paris,Lyon,100" prefWidth="250" />
                            <Button text="Add" styleClass="btn-outline" onAction="#onAddEdge" />
                        </HBox>
                        <TextArea fx:id="edgeList" styleClass="result-area" prefHeight="80" editable="false" text="No edges added yet." />
                        <HBox spacing="15">
                            <Button text="Find Shortest Route" styleClass="btn-primary" onAction="#onShortestRoute" />
                            <Button text="Find Cheapest Flight" styleClass="btn-success" onAction="#onCheapestRoute" />
                            <Button text="Clear" styleClass="btn-danger" onAction="#onClearRoute" />
                        </HBox>
                    </VBox>

                    <TextArea fx:id="routeResultArea" styleClass="result-area" prefHeight="100" editable="false" promptText="Route results will appear here..." />
                </VBox>

                <!-- ===== 4. BOOKING ===== -->
                <VBox fx:id="bookingView" managed="false" visible="false" spacing="15">
                    <Text styleClass="section-title" text="Book a Flight" />
                    <Text styleClass="section-subtitle" text="Create a new booking or cancel an existing one." />

                    <HBox spacing="30">
                        <VBox styleClass="card" spacing="12" HBox.hgrow="ALWAYS">
                            <Label styleClass="card-title" text="New Booking" />
                            <GridPane hgap="15" vgap="8">
                                <columnConstraints><ColumnConstraints minWidth="120" /><ColumnConstraints minWidth="200" /><ColumnConstraints /></columnConstraints>
                                <Label text="Ticket ID:" styleClass="form-label" GridPane.rowIndex="0" GridPane.columnIndex="0" />
                                <TextField fx:id="bookId" promptText="FT001" GridPane.rowIndex="0" GridPane.columnIndex="1" />
                                <Label text="Customer:" styleClass="form-label" GridPane.rowIndex="1" GridPane.columnIndex="0" />
                                <TextField fx:id="bookCustomer" promptText="John Doe" GridPane.rowIndex="1" GridPane.columnIndex="1" />
                                <Label text="Source:" styleClass="form-label" GridPane.rowIndex="2" GridPane.columnIndex="0" />
                                <TextField fx:id="bookSource" promptText="Paris" GridPane.rowIndex="2" GridPane.columnIndex="1" />
                                <Label text="Destination:" styleClass="form-label" GridPane.rowIndex="3" GridPane.columnIndex="0" />
                                <TextField fx:id="bookDest" promptText="Milan" GridPane.rowIndex="3" GridPane.columnIndex="1" />
                                <Label text="Price:" styleClass="form-label" GridPane.rowIndex="4" GridPane.columnIndex="0" />
                                <TextField fx:id="bookPrice" promptText="920" GridPane.rowIndex="4" GridPane.columnIndex="1" />
                            </GridPane>
                            <Button text="Book Flight" styleClass="btn-success" onAction="#onBookFlight" />
                        </VBox>

                        <VBox styleClass="card" spacing="12" HBox.hgrow="ALWAYS">
                            <Label styleClass="card-title" text="Cancel Booking" />
                            <Label styleClass="form-label" text="Ticket ID to cancel:" />
                            <TextField fx:id="cancelId" promptText="FT001" prefWidth="200" />
                            <Button text="Cancel Flight" styleClass="btn-danger" onAction="#onCancelFlight" />
                        </VBox>
                    </HBox>

                    <TextArea fx:id="bookingResultArea" styleClass="result-area" prefHeight="80" editable="false" promptText="Booking results will appear here..." />

                    <ProgressBar fx:id="progressBar" prefWidth="400" visible="false" />
                </VBox>

                <!-- ===== 5. USER ACCOUNT ===== -->
                <VBox fx:id="userView" managed="false" visible="false" spacing="15">
                    <Text styleClass="section-title" text="User Account" />
                    <Text styleClass="section-subtitle" text="Register a new account or log in to an existing one." />

                    <HBox spacing="30">
                        <VBox styleClass="card" spacing="12" HBox.hgrow="ALWAYS">
                            <Label styleClass="card-title" text="Register" />
                            <GridPane hgap="15" vgap="8">
                                <columnConstraints><ColumnConstraints minWidth="120" /><ColumnConstraints minWidth="200" /></columnConstraints>
                                <Label text="Username:" styleClass="form-label" GridPane.rowIndex="0" GridPane.columnIndex="0" />
                                <TextField fx:id="regUsername" promptText="Choose a username" GridPane.rowIndex="0" GridPane.columnIndex="1" />
                                <Label text="Password:" styleClass="form-label" GridPane.rowIndex="1" GridPane.columnIndex="0" />
                                <TextField fx:id="regPassword" promptText="Choose a password" GridPane.rowIndex="1" GridPane.columnIndex="1" />
                                <Label text="Role:" styleClass="form-label" GridPane.rowIndex="2" GridPane.columnIndex="0" />
                                <TextField fx:id="regRole" promptText="USER or ADMIN" text="USER" GridPane.rowIndex="2" GridPane.columnIndex="1" />
                            </GridPane>
                            <Button text="Register" styleClass="btn-primary" onAction="#onRegister" />
                        </VBox>

                        <VBox styleClass="card" spacing="12" HBox.hgrow="ALWAYS">
                            <Label styleClass="card-title" text="Login" />
                            <GridPane hgap="15" vgap="8">
                                <columnConstraints><ColumnConstraints minWidth="120" /><ColumnConstraints minWidth="200" /></columnConstraints>
                                <Label text="Username:" styleClass="form-label" GridPane.rowIndex="0" GridPane.columnIndex="0" />
                                <TextField fx:id="loginUsername" promptText="Your username" GridPane.rowIndex="0" GridPane.columnIndex="1" />
                                <Label text="Password:" styleClass="form-label" GridPane.rowIndex="1" GridPane.columnIndex="0" />
                                <TextField fx:id="loginPassword" promptText="Your password" GridPane.rowIndex="1" GridPane.columnIndex="1" />
                            </GridPane>
                            <Button text="Login" styleClass="btn-success" onAction="#onLogin" />
                        </VBox>
                    </HBox>

                    <TextArea fx:id="userResultArea" styleClass="result-area" prefHeight="80" editable="false" promptText="User account results will appear here..." />
                </VBox>

            </StackPane>
        </VBox>
    </center>

</BorderPane>
